# ---------------------------------------------------------------------------
# Healthcare Appointment & Follow-up Manager — Backend Environment Variables
# ---------------------------------------------------------------------------

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (SQLite default for local development)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Slot Configuration
SLOT_HOLD_TTL_SECONDS=300

# Anthropic LLM Configuration (Requires valid Anthropic API key for live AI summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email / SMTP Configuration
# Leave SMTP_HOST blank to log emails to backend console (dev fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Clinic Appointment Manager <no-reply@clinic.test>"

# Google Calendar Integration (Optional — OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
