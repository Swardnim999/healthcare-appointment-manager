# Database (SQLite - zero config)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
FRONTEND_URL="http://localhost:5173"

# LLM - Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Email (Nodemailer). If left blank, emails are logged to console instead of sent
# (useful for local dev / grading without real SMTP creds).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Clinic <no-reply@clinic.test>"

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/calendar/oauth/callback"

# Slot hold TTL in seconds (how long a slot is reserved while patient fills symptom form)
SLOT_HOLD_TTL_SECONDS=300
